# Public URL and TLS configuration
APP_DOMAIN=your-gymdesk.duckdns.org
ACME_EMAIL=owner@example.com
NEXT_PUBLIC_APP_URL=https://your-gymdesk.duckdns.org

# Supabase Free project: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key

# Generate each value independently. Never reuse development secrets.
# openssl rand -hex 32
PORTAL_TOKEN_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters
# openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64
