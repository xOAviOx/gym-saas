# Copy to .env.local for local development. Every variable is validated at boot (lib/env.ts).

# --- Supabase (local: values from `pnpm exec supabase status`; hosted: Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server only: webhooks, cron, portal routes, invite acceptance, kiosk PIN check.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Public origin without a trailing slash. Used for auth redirects, portal links and receipts.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Secrets (generate each one; never reuse across environments) ---
# HMAC key for member portal links and team invitations. 32+ chars: `openssl rand -hex 32`
PORTAL_TOKEN_SECRET=
# AES-256-GCM key for per-gym Razorpay / WhatsApp credentials. Exactly 32 bytes, base64: `openssl rand -base64 32`
SECRETS_ENCRYPTION_KEY=
# Bearer token required by /api/cron/daily. 32+ chars: `openssl rand -hex 32`
CRON_SECRET=
